PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/belfioreDb
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
FRONTEND_URL=http://localhost:5173
EMAIL_PROVIDER=smtp
EMAIL_FROM=
AUTH_EMAIL_SENDER_NAME=Belfiore Account Security
AUTH_EMAIL_SENDER_ADDRESS=
# Public HTTPS origin used in reset links. Local HTTP is allowed only for localhost/127.0.0.1 development.
PUBLIC_APP_URL=http://localhost:5173
# Fail-closed master switch for Admin/Rider security alerts and password recovery.
# Keep false until the official sender and SMTP settings are supplied.
# Admin-only feature activation is separate from this server switch.
AUTH_EMAIL_DELIVERY_ENABLED=false
# Backend staff login protection; invalid/out-of-range values use secure defaults.
# Riders: consecutive failures require manual administrator unlock; there is no timed account unlock.
# The time windows below still apply to Admin restrictions and shared IP/source limits.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_MINUTES=15
AUTH_RESTRICTION_MINUTES=15
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_DELAY_STEP_MS=100
AUTH_LOGIN_MAX_DELAY_MS=1000
RESEND_API_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=belfiore-uploads
STORAGE_DRIVER=local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_EMAIL=your-email@gmail.com
PAYMONGO_SECRET_KEY=YOUR_PAYMONGO_SECRET_KEY
PAYMONGO_WEBHOOK_SECRET=YOUR_PAYMONGO_WEBHOOK_SECRET
PAYMONGO_FRONTEND_URL=http://localhost:5173
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,paymaya,card
TRACK123_API_KEY=YOUR_TRACK123_API_KEY
TRACK123_WEBHOOK_TOKEN=YOUR_TRACK123_WEBHOOK_TOKEN
INVENTORY_RESERVATION_MINUTES=15

# Manual courier mode is the default. Legacy integration requires explicit opt-in.
TRACK123_ENABLED=false

# Customer verification stays disabled until an official SMTP sender is configured.
# Also requires AUTH_EMAIL_DELIVERY_ENABLED=true and the existing SMTP settings.
CUSTOMER_VERIFICATION_EMAIL_ENABLED=false
CUSTOMER_VERIFICATION_TTL_MINUTES=30
CUSTOMER_VERIFICATION_RESEND_SECONDS=60
